{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    /* Path alias — baseUrl 제거: TS6 에서 deprecated(TS7 제거 예정). bundler 모드는 baseUrl 없이 paths 해석 */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Types — vite-plugin-pwa/client 는 virtual:pwa-register 모듈 타입(PWABadge 가 소비) */
    "types": ["vitest/globals", "@testing-library/jest-dom", "vite-plugin-pwa/client"]
  },
  "include": ["src", "vitest.setup.ts"]
}
